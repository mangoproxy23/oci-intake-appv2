  if (cmpSeries.length >= 4) {
    // Current Spend = faded horizontal reference line, level with the "Today" bar
    cmpSeries[3].setChartType(ExcelScript.ChartType.line);
    cmpSeries[3].getFormat().getLine().setColor("#E6A9A9");
  }

  // ---- Existing-spend ramp adjuster, placed to the RIGHT of the (now wider) chart (cols T:V) ----
  // Edit the yellow "Existing Util %" cells to ramp the existing infrastructure spend up/down
  // across the 5 years. The comparison chart's "Existing Infra Cost" series reads from here.
  overview.getRange("T:V").getFormat().setColumnWidth(125);
  hdrBand("T8:V8", "T8", "Existing Spend - Ramp %");
  overview.getRange("T9").setValue("Year");
  overview.getRange("U9").setValue("Existing Infra Cost");
  overview.getRange("V9").setValue("Existing Util %");
  colHdr("T9:V9");
  for (let y = 0; y < 5; y++) {
    const r = 10 + y;
    overview.getRange(`T${r}`).setValue(`Year ${y + 1}`);
    overview.getRange(`V${r}`).setValue(1);                  // editable ramp %, default 100%
    overview.getRange(`V${r}`).setNumberFormatLocal("0%");
    overview.getRange(`U${r}`).setFormula(`=$B$18*V${r}`);   // existing cost x utilization
  }
  overview.getRange("U10:U14").setNumberFormatLocal("$#,##0.00");
  overview.getRange("T10:T14").getFormat().setHorizontalAlignment(ExcelScript.HorizontalAlignment.center);
  overview.getRange("V10:V14").getFormat().setHorizontalAlignment(ExcelScript.HorizontalAlignment.center);
  overview.getRange("V10:V14").getFormat().getFill().setColor(ov_input); // editable ramp cells
  applyOuterBorder(overview.getRange("V10:V14"), ov_inputBorder, ExcelScript.BorderLineStyle.thin);
  applyOuterBorder(overview.getRange("T9:V14"), ov_navy, ExcelScript.BorderLineStyle.thin);

  overview.getRange("A1").getFormat().getFont().setName("Calibri");
  on_prem_data_sheet.setName("Base Data");
  new_bom_sheet.setPosition(0);
  overview.setPosition(0);
  overview.activate();
}
